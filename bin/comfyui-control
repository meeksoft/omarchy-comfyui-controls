#!/usr/bin/env python3
"""Dependency-free lifecycle and status helper for ComfyUI Control."""

import argparse, base64, fcntl, hashlib, json, os, re, secrets, socket, struct, subprocess, time, uuid
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

UNIT_PREFIX = "omarchy-comfyui-"


def emit(value):
    print(json.dumps(value, separators=(",", ":")), flush=True)


def url(host, port, path=""):
    host = f"[{host}]" if ":" in host and not host.startswith("[") else host
    return f"http://{host}:{port}{path}"


def api(host, port, path, method="GET", body=None, timeout=1.5):
    request = Request(url(host, port, path), data=body, method=method)
    if body is not None:
        request.add_header("Content-Type", "application/json")
    with urlopen(request, timeout=timeout) as response:
        return json.load(response)


def health(host, port, timeout=1.5):
    try:
        value = api(host, port, "/system_stats", timeout=timeout)
        system, devices = value.get("system", {}), value.get("devices", [])
        version = system.get("comfyui_version")
        if not version:
            return None
        device = devices[0] if devices else {}
        return {"version": version, "device": str(device.get("name", "")),
                "vramTotal": int(device.get("vram_total", 0) or 0),
                "vramFree": int(device.get("vram_free", 0) or 0)}
    except (OSError, ValueError, HTTPError, URLError):
        return None


def port_open(host, port):
    try:
        with socket.create_connection((host, port), timeout=.4):
            return True
    except OSError:
        return False


def key(host, port):
    return hashlib.sha256(f"{host}:{port}".encode()).hexdigest()[:16]


def data_dir(runtime=False):
    if runtime:
        base = os.environ.get("XDG_RUNTIME_DIR")
        path = ((Path(base) if base else Path("/tmp") / f"comfyui-control-{os.getuid()}") / "comfyui-control")
    else:
        base = os.environ.get("XDG_STATE_HOME")
        path = (Path(base) if base else Path.home() / ".local/state") / "omarchy/comfyui-control"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def state_path(host, port):
    return data_dir() / f"{key(host, port)}.json"


def current_boot():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return ""


def load_state(host, port):
    try:
        value = json.loads(state_path(host, port).read_text())
        unit = str(value.get("unit", ""))
        return value if unit.startswith(UNIT_PREFIX) and unit.endswith(".service") else None
    except (OSError, ValueError):
        return None


def save_state(host, port, unit):
    path, temporary = state_path(host, port), state_path(host, port).with_suffix(".tmp")
    temporary.write_text(json.dumps({"unit": unit, "host": host, "port": port,
                                     "boot": current_boot()}) + "\n")
    temporary.chmod(0o600); temporary.replace(path)


def unit_active(unit):
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def unit_result(unit):
    result = subprocess.run(["systemctl", "--user", "show", unit, "-p", "Result", "--value"],
                            text=True, capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def stale_unit(host, port):
    """Classify a recorded unit that is no longer running: crashed only when
    it failed during this boot. Reboots and clean stops read as offline, and
    their state files are cleared."""
    value = load_state(host, port)
    if not value: return None
    if value.get("boot") and value.get("boot") != current_boot():
        state_path(host, port).unlink(missing_ok=True)
        return None
    if unit_result(value["unit"]) not in ("", "success"):
        return "crashed"
    state_path(host, port).unlink(missing_ok=True)
    return None


def owned(host, port):
    value = load_state(host, port)
    return bool(value and unit_active(value["unit"]))


def queue_job(item, state, position):
    if not isinstance(item, list) or len(item) < 4:
        return {"state": state, "position": position, "promptId": "", "number": position}
    prompt = item[2] if isinstance(item[2], dict) else {}
    extra = item[3] if isinstance(item[3], dict) else {}
    return {"state": state, "position": position, "number": item[0], "promptId": str(item[1]),
            "createdAt": int(extra.get("create_time", 0) or 0), "nodeCount": len(prompt),
            "outputNodeCount": len(item[4]) if len(item) > 4 and isinstance(item[4], list) else 0}


def history_summary(host, port):
    outputs, events = [], []
    try:
        history = api(host, port, "/history?max_items=8")
        for prompt_id, item in reversed(list(history.items())):
            messages = item.get("status", {}).get("messages", [])
            completed_at = 0
            for message in messages:
                if not isinstance(message, list) or len(message) < 2 or not isinstance(message[1], dict):
                    continue
                kind, data = str(message[0]), message[1]
                timestamp = int(data.get("timestamp", 0) or 0)
                if kind == "execution_success": completed_at = timestamp
                if kind in {"execution_error", "execution_interrupted"}:
                    events.append({"level": "error" if kind == "execution_error" else "warning",
                                   "kind": kind, "timestamp": timestamp, "promptId": str(prompt_id),
                                   "message": str(data.get("exception_message") or kind.replace("_", " "))[:240]})
            for output in reversed(list(item.get("outputs", {}).values())):
                if not isinstance(output, dict): continue
                for field, media_kind in (("images", "image"), ("gifs", "video"), ("videos", "video"), ("audio", "audio")):
                    for media in reversed(output.get(field, [])):
                        if not isinstance(media, dict) or not media.get("filename"): continue
                        query = urlencode({"filename": media["filename"], "subfolder": media.get("subfolder", ""),
                                           "type": media.get("type", "output")})
                        outputs.append({"promptId": str(prompt_id), "filename": str(media["filename"]),
                                        "subfolder": str(media.get("subfolder", "")), "type": str(media.get("type", "output")),
                                        "mediaKind": media_kind, "completedAt": completed_at,
                                        "viewUrl": url(host, port, f"/view?{query}")})
                        if len(outputs) >= 12: break
                    if len(outputs) >= 12: break
                if len(outputs) >= 12: break
            if len(outputs) >= 12: break
    except (OSError, ValueError, KeyError, HTTPError, URLError):
        pass
    events.sort(key=lambda item: item.get("timestamp", 0), reverse=True)
    return {"outputs": outputs, "recentEvents": events[:20]}


def summarize_log_text(text):
    result, seen = [], set()
    ansi = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
    progress_bar = re.compile(r"^\s*\d+%\|.*\|\s*\d+/\d+")
    for line in reversed(text.splitlines()):
        clean = ansi.sub("", line).replace("\x00", "").strip()
        if not clean or progress_bar.match(clean): continue
        upper = clean.upper()
        level = "error" if "ERROR" in upper or "TRACEBACK" in upper else "warning" if "WARN" in upper else "info"
        significant = level != "info" or any(token in upper for token in ("[INFO]", "START", "PROMPT", "EXECUT", "SERVER"))
        fingerprint = re.sub(r"\s+", " ", clean)
        if significant and fingerprint not in seen:
            result.append({"level": level, "message": clean[:300]})
            seen.add(fingerprint)
        if len(result) >= 30: break
    return result


def log_summary(path_value):
    if not path_value: return []
    path = Path(path_value).expanduser()
    if not path.is_file(): return []
    return summarize_log_text(tail_text(path))


def journal_summary(host, port):
    value = load_state(host, port)
    if not value: return []
    result = subprocess.run(["journalctl", "--user", "-u", value["unit"], "-n", "200", "-o", "cat", "--no-pager"],
                            text=True, capture_output=True)
    return summarize_log_text(result.stdout) if result.returncode == 0 else []


TQDM_LINE = re.compile(r"(\d+)%\|[^\r\n|]*\|\s*(\d+)/(\d+)\s*\[([0-9:]+)?(?:<([0-9:]+))?(?:[^,\]]*,\s*([0-9.?]+)\s*(it/s|s/it))?\]")


def parse_clock(value):
    if not value: return 0
    total = 0
    try:
        for part in value.split(":"): total = total * 60 + int(part)
    except ValueError:
        return 0
    return total


def tail_text(path, limit=65536):
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END); size = handle.tell(); handle.seek(max(0, size - limit))
            return handle.read().decode(errors="replace")
    except OSError:
        return ""


def server_log_path(host, port):
    return data_dir() / f"{key(host, port)}.log"


def parse_progress(text):
    """Newest tqdm sampler bar in a chunk of server output."""
    for chunk in reversed(re.split(r"[\r\n]", text)):
        match = TQDM_LINE.search(chunk)
        if not match: continue
        value, maximum = int(match.group(2)), int(match.group(3))
        if maximum <= 0: continue
        eta = parse_clock(match.group(5))
        rate = float(match.group(6) or 0) if match.group(6) != "?" else 0
        if eta <= 0 and rate > 0 and maximum > value:
            eta = (maximum - value) / rate if match.group(7) == "it/s" else (maximum - value) * rate
        return {"value": value, "max": maximum, "etaSeconds": int(eta) if eta > 0 else -1}
    return None


def log_progress(host, port):
    """Current sampler progress from the managed server's streamed log file.

    The unit streams stdout/stderr to this file unbuffered, so tqdm renders
    (\r-separated) land immediately instead of waiting for a newline like the
    journal does. A file untouched for two minutes reads as stale.
    """
    path = server_log_path(host, port)
    try:
        if time.time() - path.stat().st_mtime > 120: return None
    except OSError:
        return None
    return parse_progress(tail_text(path))


def queue_state(host, port):
    """Live queue via /api/jobs when the server offers it, else legacy /queue."""
    items = None
    try:
        items = api(host, port, "/api/jobs?status=in_progress,pending&sort_order=asc&limit=20").get("jobs", [])
    except (OSError, ValueError, HTTPError, URLError):
        pass
    if items is not None:
        counts = {}
        try:
            queue = api(host, port, "/queue")
            for item in list(queue.get("queue_running", [])) + list(queue.get("queue_pending", [])):
                if isinstance(item, list) and len(item) >= 4:
                    prompt = item[2] if isinstance(item[2], dict) else {}
                    outputs = len(item[4]) if len(item) > 4 and isinstance(item[4], list) else 0
                    counts[str(item[1])] = (len(prompt), outputs)
        except (OSError, ValueError, HTTPError, URLError, AttributeError):
            pass
        jobs = []
        for item in items:
            if not isinstance(item, dict): continue
            prompt_id = str(item.get("id", ""))
            nodes = counts.get(prompt_id, (0, 0))
            jobs.append({"state": "running" if str(item.get("status", "")) == "in_progress" else "pending",
                         "position": 0, "promptId": prompt_id, "number": int(item.get("priority", 0) or 0),
                         "createdAt": int(item.get("create_time", 0) or 0),
                         "startedAt": int(item.get("execution_start_time", 0) or 0),
                         "nodeCount": nodes[0], "outputNodeCount": nodes[1]})
        pending = [job for job in jobs if job["state"] == "pending"]
        for index, job in enumerate(pending): job["position"] = index + 1
        return sum(1 for job in jobs if job["state"] == "running"), len(pending), jobs
    try:
        queue = api(host, port, "/queue")
        running_items, pending_items = queue.get("queue_running", []), queue.get("queue_pending", [])
        jobs = ([queue_job(item, "running", index + 1) for index, item in enumerate(running_items)] +
                [queue_job(item, "pending", index + 1) for index, item in enumerate(pending_items)])
        return len(running_items), len(pending_items), jobs
    except (OSError, ValueError, HTTPError, URLError, AttributeError):
        return 0, 0, []


def status(host, port, log_path=""):
    info = health(host, port)
    occupied = info is None and port_open(host, port)
    if info is None and occupied: info = health(host, port, 5.0)
    if not info:
        state = "foreign-port" if occupied else stale_unit(host, port) or "offline"
        return {"ok": True, "state": state, "healthy": False, "owned": owned(host, port),
                "running": 0, "pending": 0, "jobs": [], "outputs": [], "recentEvents": [],
                "logEvents": (log_summary(log_path) + journal_summary(host, port))[:30], "url": url(host, port)}
    try:
        running, pending, jobs = queue_state(host, port)
    except (OSError, ValueError, HTTPError, URLError):
        running = pending = 0; jobs = []
    state = "generating" if running else "queued" if pending else "idle"
    history = history_summary(host, port)
    outputs = history["outputs"]
    server_log = server_log_path(host, port)
    server_events = summarize_log_text(tail_text(server_log)) if server_log.is_file() else journal_summary(host, port)
    result = {"ok": True, "state": state, "healthy": True, "owned": owned(host, port),
              "running": running, "pending": pending, "jobs": jobs, "outputs": outputs,
              "previewUrl": outputs[0]["viewUrl"] if outputs else "", "url": url(host, port),
              "recentEvents": history["recentEvents"],
              "logEvents": (log_summary(log_path) + server_events)[:30], **info}
    progress = log_progress(host, port) if running else None
    if progress: result["progress"] = progress
    return result


def lock(host, port):
    handle = (data_dir(True) / f"comfyui-control-{key(host, port)}.lock").open("w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def python_for(root, configured):
    candidates = [Path(configured)] if configured else [root / "venv/bin/python", root / ".venv/bin/python",
        root.parent / "venv/bin/python", root.parent / ".venv/bin/python"]
    # Return the candidate itself, never a resolved symlink: a venv's python points at the
    # base interpreter, and launching the base interpreter does not activate the venv.
    return next((item for item in candidates if item.is_file() and os.access(item, os.X_OK)), None)


def start(args):
    if args.host.lower() not in {"127.0.0.1", "localhost", "::1"}:
        return {"ok": False, "state": "error", "message": "Only local servers can be started."}
    with lock(args.host, args.port):
        current = status(args.host, args.port, args.log_path)
        if current["healthy"]:
            return {**current, "message": "Using the running ComfyUI server."}
        if current["state"] == "foreign-port":
            return {**current, "ok": False, "message": "The configured port belongs to another application."}
        if current["owned"]:
            return {**current, "state": "starting", "message": "ComfyUI is already starting."}
        root = Path(args.root).expanduser().resolve() if args.root else None
        if not root or not (root / "main.py").is_file():
            return {"ok": False, "state": "error", "message": "Choose the ComfyUI folder containing main.py."}
        python = python_for(root, args.python)
        if not python:
            return {"ok": False, "state": "error", "message": "No ComfyUI Python environment was found."}
        unit = f"{UNIT_PREFIX}{args.port}-{secrets.token_hex(4)}.service"
        server_log = server_log_path(args.host, args.port)
        with server_log.open("w"): pass
        # No --collect: a failed unit must survive so its Result stays readable
        # for crash classification; clean stops unload on their own.
        command = ["systemd-run", "--user", f"--unit={unit}", "--quiet",
                   f"--property=WorkingDirectory={root}", "--setenv=PYTHONUNBUFFERED=1",
                   f"--property=StandardOutput=append:{server_log}",
                   f"--property=StandardError=append:{server_log}",
                   "--", str(python), str(root / "main.py"),
                   "--listen", args.host, "--port", str(args.port)]
        result = subprocess.run(command, text=True, capture_output=True)
        if result.returncode:
            return {"ok": False, "state": "error", "message": (result.stderr or result.stdout)[:240].strip()}
        save_state(args.host, args.port, unit)
        subprocess.run(["systemctl", "--user", "reset-failed", f"{UNIT_PREFIX}*.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + args.start_timeout
    while time.monotonic() < deadline:
        current = status(args.host, args.port, args.log_path)
        if current["healthy"]:
            return {**current, "message": "ComfyUI started."}
        if not unit_active(unit):
            break
        time.sleep(.5)
    return {"ok": False, "state": "error", "owned": unit_active(unit),
            "message": "ComfyUI did not become ready. Check the service log."}


def stop(host, port):
    with lock(host, port):
        value = load_state(host, port)
        if not value:
            return {"ok": False, "state": "unowned", "message": "This server was not started by ComfyUI Control."}
        unit = value["unit"]
        if unit_active(unit):
            result = subprocess.run(["systemctl", "--user", "stop", unit], text=True, capture_output=True)
            if result.returncode:
                return {"ok": False, "state": "error", "message": (result.stderr or result.stdout)[:240].strip()}
        state_path(host, port).unlink(missing_ok=True)
    return {"ok": True, "state": "offline", "message": "ComfyUI stopped."}


def interrupt(host, port):
    if not health(host, port):
        return {"ok": False, "state": "offline", "message": "ComfyUI is not available."}
    try:
        api(host, port, "/interrupt", "POST", b"{}")
        return {"ok": True, "state": "idle", "message": "Interrupt requested."}
    except (OSError, ValueError, HTTPError, URLError) as error:
        return {"ok": False, "state": "error", "message": f"Interrupt failed: {error}"[:240]}


def exact(connection, count):
    result = bytearray()
    while len(result) < count:
        part = connection.recv(count - len(result))
        if not part:
            raise ConnectionError("WebSocket closed")
        result.extend(part)
    return bytes(result)


def watch(host, port):
    connection = socket.create_connection((host, port), timeout=5)
    ws_key = base64.b64encode(secrets.token_bytes(16)).decode()
    request = (f"GET /ws?clientId={uuid.uuid4().hex} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\n"
               f"Connection: Upgrade\r\nSec-WebSocket-Key: {ws_key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
    connection.sendall(request.encode("ascii")); response = bytearray()
    while b"\r\n\r\n" not in response:
        response.extend(connection.recv(4096))
    if not bytes(response).startswith(b"HTTP/1.1 101"):
        raise ConnectionError("WebSocket upgrade rejected")
    with connection:
        connection.settimeout(None)
        while True:
            first, second = exact(connection, 2); opcode, length = first & 15, second & 127
            if length == 126: length = struct.unpack("!H", exact(connection, 2))[0]
            elif length == 127: length = struct.unpack("!Q", exact(connection, 8))[0]
            payload = exact(connection, length)
            if opcode == 8: return 0
            if opcode == 9 and len(payload) < 126:
                connection.sendall(bytes((0x8A, len(payload))) + payload)
            if opcode != 1: continue
            try: message = json.loads(payload)
            except (UnicodeDecodeError, ValueError): continue
            event_type, data = str(message.get("type", "")), message.get("data", {})
            event = {"type": event_type}
            if event_type == "progress":
                event.update(value=int(data.get("value", 0) or 0), max=int(data.get("max", 0) or 0),
                             node=str(data.get("node", "")), promptId=str(data.get("prompt_id", "")))
            elif event_type == "executing":
                event.update(node=str(data.get("node") or ""), promptId=str(data.get("prompt_id", "")))
            elif event_type == "status":
                event["queueRemaining"] = int(data.get("status", {}).get("exec_info", {}).get("queue_remaining", 0) or 0)
            elif event_type in {"execution_start", "execution_success"}:
                event.update(promptId=str(data.get("prompt_id", "")),
                             timestamp=int(data.get("timestamp", 0) or int(time.time() * 1000)))
            elif event_type in {"execution_error", "execution_interrupted"}:
                event.update(message=str(data.get("exception_message") or event_type.replace("_", " ")),
                             promptId=str(data.get("prompt_id", "")),
                             timestamp=int(data.get("timestamp", 0) or int(time.time() * 1000)))
            emit(event)


def arguments():
    common = argparse.ArgumentParser(add_help=False); common.add_argument("--host", default="127.0.0.1"); common.add_argument("--port", type=int, default=8188); common.add_argument("--log-path", default="")
    parser = argparse.ArgumentParser(); commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status", parents=[common]); launch = commands.add_parser("start", parents=[common])
    launch.add_argument("--root", default=""); launch.add_argument("--python", default=""); launch.add_argument("--start-timeout", type=float, default=30)
    commands.add_parser("stop", parents=[common]); commands.add_parser("interrupt", parents=[common]); commands.add_parser("watch", parents=[common])
    return parser.parse_args()


def main():
    args = arguments()
    try:
        if not 1 <= args.port <= 65535: raise ValueError("Port must be between 1 and 65535.")
        if args.command == "watch": return watch(args.host, args.port)
        result = status(args.host, args.port, args.log_path) if args.command == "status" else start(args) if args.command == "start" else stop(args.host, args.port) if args.command == "stop" else interrupt(args.host, args.port)
        emit(result); return 0 if result.get("ok") else 1
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        emit({"ok": False, "state": "error", "message": str(error)[:240]}); return 1


if __name__ == "__main__": raise SystemExit(main())
